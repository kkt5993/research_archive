# KRX 데이터 서비스 자격증명 — 예시 파일
#
# 실제 값은 이 저장소에 절대 커밋하지 않는다.
# 아래 중 한 곳에 두면 종가_수집_로컬.py 가 자동으로 읽는다.
#   1) ~/.config/krx/env        (권장 — 저장소 밖)
#   2) _scripts/krx.env         (.gitignore 처리됨)
#
# 만드는 법 (셸 히스토리에 안 남기려면 앞에 공백 한 칸):
#    mkdir -p ~/.config/krx && printf 'KRX_ID=아이디\nKRX_PW=비밀번호\n' > ~/.config/krx/env && chmod 600 ~/.config/krx/env
#
# 또는 이 파일을 복사해서 채운다:
#    cp _scripts/krx.env.example _scripts/krx.env && chmod 600 _scripts/krx.env

KRX_ID=
KRX_PW=
